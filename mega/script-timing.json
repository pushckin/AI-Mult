  "partStart": 35.82
 },
 "3": {
  "duration": 24.15,
  "lines": [
   {
    "id": 21,
    "who": "ustav",
    "text": "Хохотун, координаты я тебе дал.",
    "t": 1.6,
    "dur": 1.95,
    "file": "L21.wav"
   },
   {
    "id": 22,
    "who": "hohotun",
    "text": "Дали! Хи-хи-хи. Я только цифры местами поменял. Так красивее.",
    "t": 3.85,
    "dur": 5.48,
    "file": "L22.wav"
   },
   {
    "id": 23,
    "who": "hohotun",
    "text": "В голову!",
    "t": 14.83,
    "dur": 0.71,
    "file": "L23.wav"
   },
   {
    "id": 24,
    "who": "ustav",
    "text": "Чайка. Свои. Чаевые соберите, семье отправим.",
    "t": 16.05,
    "dur": 4.52,
    "file": "L24.wav"
   },
   {
    "id": 25,
    "who": "ladoshka",
    "text": "Семье — после моей комиссии.",
    "t": 20.96,
    "dur": 2.19,
    "file": "L25.wav"
   }
  ],
  "beats": {
