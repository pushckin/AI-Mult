 },
 "2": {
  "duration": 25.85,
  "lines": [
   {
    "id": 11,
    "who": "chaika",
    "text": "Сразу предупреждаю: это мой первый полёт.",
    "t": 1.2,
    "dur": 2.57,
    "file": "L11.wav"
   },
   {
    "id": 12,
    "who": "ustav",
    "text": "Ты это говорил утром.",
    "t": 4.12,
    "dur": 1.37,
    "file": "L12.wav"
   },
   {
    "id": 13,
    "who": "chaika",
    "text": "Утром я не взлетел. Не считается.",
    "t": 5.78,
    "dur": 2.06,
    "file": "L13.wav"
   },
   {
    "id": 14,
    "who": "gvozd",
    "text": "Командир, а парашюты есть?",
    "t": 10.05,
    "dur": 1.84,
    "file": "L14.wav"
   },
   {
    "id": 15,
    "who": "ustav",
    "text": "Есть. Один.",
    "t": 12.24,
    "dur": 1.59,
    "file": "L15.wav"
   },
   {
    "id": 16,
    "who": "gvozd",
    "text": "На пятерых?",
    "t": 14.13,
    "dur": 0.89,
    "file": "L16.wav"
   },
   {
    "id": 17,
    "who": "chaika",
    "text": "На пилота.",
    "t": 15.32,
    "dur": 0.61,
    "file": "L17.wav"
   },
   {
    "id": 18,
    "who": "chaika",
    "text": "Приехали. Как договаривались — на чай.",
    "t": 18.53,
    "dur": 2.12,
    "file": "L18.wav"
   },
   {
    "id": 19,
    "who": "ustav",
    "text": "До зоны три километра.",
    "t": 21.05,
    "dur": 1.23,
    "file": "L19.wav"
   },
   {
    "id": 20,
    "who": "chaika",
    "text": "Зато живые. Пока.",
    "t": 22.63,
    "dur": 1.92,
    "file": "L20.wav"
   }
  ],
  "beats": {
   "intro": {
    "t": 0.0,
    "dur": 1.2
   },
