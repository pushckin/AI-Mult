 "4": {
  "duration": 20.19,
  "lines": [
   {
    "id": 26,
    "who": "ustav",
    "text": "Где выход?",
    "t": 2.0,
    "dur": 0.73,
    "file": "L26.wav"
   },
   {
    "id": 27,
    "who": "gvozd",
    "text": "Так безопаснее. Никто не войдёт.",
    "t": 3.08,
    "dur": 2.1,
    "file": "L27.wav"
   },
   {
    "id": 28,
    "who": "ustav",
    "text": "А мы как выйдем?",
    "t": 5.53,
    "dur": 1.27,
    "file": "L28.wav"
   },
   {
    "id": 29,
    "who": "gvozd",
    "text": "А нам надо?",
    "t": 8.1,
    "dur": 0.62,
    "file": "L29.wav"
   },
   {
    "id": 30,
    "who": "ladoshka",
    "text": "Гвоздь, поздравляю, десятая! Эта — за счёт заведения.",
    "t": 14.22,
    "dur": 4.22,
    "file": "L30.wav"
   },
   {
    "id": 31,
    "who": "gvozd",
    "text": "Ура.",
    "t": 18.85,
    "dur": 0.45,
    "file": "L31.wav"
   }
  ],
